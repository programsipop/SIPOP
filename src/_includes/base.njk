{# src/_includes/base.njk — layout base de todas as páginas, agora multilíngue #}
{% set t = i18n[lang] %}
{% set baseUrl = "https://sipopscience.com" %}
<!DOCTYPE html>
<html lang="{{ t.htmlLang }}" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if pageKey == "home" %}{{ t[pageKey].title }}{% else %}{{ t[pageKey].title }} - SIPOP{% endif %}</title>
    <meta name="description" content="{{ t[pageKey].description }}">
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon/Icon.ico">

    <!-- Fonte Inter — preconnect + link (troca do @import, que serializava o carregamento) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,900;1,400&display=swap">

    <!-- Preload da imagem de fundo do hero (background-image via CSS só é descoberta após o parse do CSS) -->
    <link rel="preload" as="image" href="/assets/images/backgrounds/BG1.webp" fetchpriority="high">

    <link rel="stylesheet" href="/assets/css/style.css">
    {% if extraCss %}
        {% for css in extraCss %}
            <link rel="stylesheet" href="/assets/css/{{ css }}">
        {% endfor %}
    {% endif %}

    <!-- hreflang / SEO multilíngue -->
    <link rel="canonical" href="{{ baseUrl }}{{ t.urlPrefix }}/{{ slug }}">
    {% for code, locale in i18n %}
    <link rel="alternate" hreflang="{{ locale.htmlLang }}" href="{{ baseUrl }}{{ locale.urlPrefix }}/{{ slug }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ baseUrl }}/{{ slug }}">

    <!-- Open Graph / Twitter Card -->
    {% set ogTitle = t[pageKey].title %}
    {% set ogDescription = t[pageKey].description %}
    {% set ogUrl = baseUrl + t.urlPrefix + "/" + slug %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="SIPOP">
    <meta property="og:locale" content="{{ t.htmlLang | replace('-', '_') }}">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDescription }}">
    <meta property="og:url" content="{{ ogUrl }}">
    <meta property="og:image" content="{{ baseUrl }}/assets/images/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="SIPOP — Scientific Integrity and Publication Oversight Program">
    {% for code, locale in i18n %}
        {% if locale.htmlLang != t.htmlLang %}
    <meta property="og:locale:alternate" content="{{ locale.htmlLang | replace('-', '_') }}">
        {% endif %}
    {% endfor %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle }}">
    <meta name="twitter:description" content="{{ ogDescription }}">
    <meta name="twitter:image" content="{{ baseUrl }}/assets/images/og-image.png">

    <!-- Meta Pixel + Google tag (gtag.js) — carregados de forma adiada -->
    <!-- Motivo: no PageSpeed, esses dois scripts eram o maior consumidor de -->
    <!-- CPU logo no início da página (78 KiB + 73 KiB de JS não usado), -->
    <!-- atrasando em ~2s a pintura do elemento de LCP. O rastreamento -->
    <!-- (fbq/gtag) segue funcionando normalmente — só a inicialização passa -->
    <!-- a ocorrer depois que a página termina de carregar, e não durante o -->
    <!-- carregamento crítico. O evento de conversão (Lead/generate_lead) só -->
    <!-- dispara no envio do formulário, bem mais tarde, então isso não afeta -->
    <!-- o rastreamento de leads. -->
    <script>
    function sipopLoadTrackingScripts() {
        // Meta Pixel
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1995945461035340');
        fbq('track', 'PageView');

        // Google tag (gtag.js)
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-9MEJZE3T7Q');

        var gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-9MEJZE3T7Q';
        document.head.appendChild(gtagScript);
    }

    if (document.readyState === 'complete') {
        sipopLoadTrackingScripts();
    } else {
        window.addEventListener('load', function () {
            // pequeno atraso pra garantir que o LCP já pintou antes desses
            // scripts começarem a rodar
            setTimeout(sipopLoadTrackingScripts, 1000);
        });
    }
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1995945461035340&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel + gtag -->

</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

    {% if header == "minimal" %}
        {% include "lp-header.njk" %}
    {% else %}
        {% include "navbar.njk" %}
    {% endif %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}

    <script src="/assets/js/script.js" defer></script>
    {% if extraJs %}
        {% for js in extraJs %}
            <script src="/assets/js/{{ js }}"></script>
        {% endfor %}
    {% endif %}
</body>
</html>
