{# src/_includes/content/publications.njk — conteúdo da página de publicações, parametrizado por t/lang #}
{% from "macros.njk" import publicationCard %}
{% set p = t.publications %}

<!-- ========== HERO ========== -->
<section class="pub-hero">
    <div class="container">
        <div class="pub-hero__tag">{{ p.hero.tag }}</div>
        <h1>{{ p.hero.title }}</h1>
        <p>{{ p.hero.subtitle }}</p>
        <div class="pub-hero__stats">
            {% for stat in p.hero.stats %}
            <div class="pub-stat{% if stat.breakdown %} pub-stat--expandable{% endif %}">
                {% if stat.breakdown %}
                <button type="button" class="pub-stat__toggle" aria-expanded="false" aria-controls="journal-breakdown">
                    <span class="pub-stat__number">{{ stat.number }}</span>
                    <span class="pub-stat__label">{{ stat.label }}</span>
                    <span class="pub-stat__chevron" aria-hidden="true">▾</span>
                </button>
                <div class="pub-stat__breakdown" id="journal-breakdown" hidden>
                    {% for b in stat.breakdown %}
                    <span class="pub-stat__breakdown-item">{{ b.number }} {{ b.label }}</span>
                    {% endfor %}
                </div>
                {% else %}
                <span class="pub-stat__number">{{ stat.number }}</span>
                <span class="pub-stat__label">{{ stat.label }}</span>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        <p class="pub-hero__stats-caption">{{ p.hero.statsCaption }}</p>
    </div>
</section>

<!-- ========== AREAS OF FOCUS ========== -->
<section class="pub-areas">
    <div class="container">
        <h2 class="pub-areas__title">{{ p.hero.areas.title }}</h2>
        <div class="pub-areas__list">
            {% for area in p.hero.areas.items %}
            <div class="pub-areas__row">
                <span class="pub-areas__label">{{ area.label }}</span>
                <div class="pub-areas__bar-track">
                    <div class="pub-areas__bar-fill" style="width: {{ area.percent }}%;"></div>
                </div>
                <span class="pub-areas__percent">{{ area.percent }}%</span>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ========== FILTERS ========== -->
<section class="pub-filters">
    <div class="container">
        <div class="pub-filters__list" role="group" aria-label="Filter publications by type">
            <button class="pub-filter active" data-filter="all">{{ p.filters.all }}</button>
            <button class="pub-filter" data-filter="systematic-review">{{ p.filters["systematic-review"] }}</button>
            <button class="pub-filter" data-filter="meta-analysis">{{ p.filters["meta-analysis"] }}</button>
            <button class="pub-filter" data-filter="rct">{{ p.filters.rct }}</button>
        </div>
    </div>
</section>

<!-- ========== PUBLICATIONS GRID ========== -->
<section class="pub-grid-section">
    <div class="container">
        <div class="pub-grid" id="pubGrid">
            {% for pub in publications %}
                {{ publicationCard(pub, t, lang) }}
            {% endfor %}
        </div>

        <p class="pub-empty" id="pubEmpty" style="display:none;">{{ p.emptyMessage }}</p>

    </div>
</section>

<!-- ========== CTA ========== -->
<section class="pub-cta">
    <div class="container">
        <h2>{{ p.cta.title }}</h2>
        <p>{{ p.cta.body }}</p>
        <a href="{{ t.urlPrefix }}/technical-review" class="btn-primary">{{ p.cta.button }}</a>
    </div>
</section>
