{# src/_includes/navbar.njk — header completo, usado em index e publications #}
<header class="main-header">
    <nav class="navbar">
        <div class="logo">
            <a href="{{ t.urlPrefix }}/">
                <img src="/assets/images/logo/Logo1.webp" alt="SIPOP Logo" class="brand-logo brand-logo--light">
                <img src="/assets/images/logo/Logo2.webp" alt="SIPOP Logo" class="brand-logo brand-logo--dark">
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="{{ t.urlPrefix }}/#about">{{ t.nav.about }}</a></li>
            <li><a href="{{ t.urlPrefix }}/#process">{{ t.nav.process }}</a></li>
            <li><a href="{{ t.urlPrefix }}/#services">{{ t.nav.services }}</a></li>
            <li><a href="{{ t.urlPrefix }}/#benefits">{{ t.nav.benefits }}</a></li>
            <li><a href="{{ t.urlPrefix }}/publications">{{ t.nav.publications }}</a></li>
            <li><a href="{{ t.urlPrefix }}/#contact" class="btn-outline">{{ t.nav.contact }}</a></li>
        </ul>
        <div class="lang-switcher" role="group" aria-label="Language selector">
            {% for code, locale in i18n %}
            <a href="{{ locale.urlPrefix }}/{{ slug }}" class="lang-switcher__link{% if code == lang %} active{% endif %}" {% if code == lang %}aria-current="true"{% endif %}>{{ code | upper }}</a>
            {% endfor %}
        </div>
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
            <span class="theme-toggle__icon theme-toggle__icon--sun">☀️</span>
            <span class="theme-toggle__icon theme-toggle__icon--moon">🌙</span>
            <span class="theme-toggle__icon theme-toggle__icon--system">⚙️</span>
        </button>
    </nav>
</header>
